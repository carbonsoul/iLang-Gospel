---
layout: null
sitemap: false
---
{%- assign essays = site.pages | where_exp: "item", "item.path contains 'articles/'" | sort: "path" -%}
{
  {%- for essay in essays %}
    {{ essay.url | jsonify }}: {{ essay.title | append: ' ' | append: essay.content | strip_html | normalize_whitespace | jsonify }}{% unless forloop.last %},{% endunless %}
  {%- endfor %}
}
